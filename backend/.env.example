# Optional: enables the LLM explanation layer. If unset, the backend uses a
# deterministic offline fallback and the app works fully without any key.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for explanations.
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173

# Port the FastAPI server listens on.
PORT=8000
